{
  "expo": {
    "name": "TimeIsMoney",
    "slug": "TimeIsMoney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/time_is_money_icon.png",
    "scheme": "timeismoney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/time_is_money_icon-foreground.png",
        // "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/time_is_money_icon-monochrome.png"
      },
      "package": "com.goosetaph.time_is_money",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/time_is_money_favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-splash-1920x1920.png",
          // "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11f87807-6052-4d9c-bbac-f264c19434c4"
      }
    }
  }
}
